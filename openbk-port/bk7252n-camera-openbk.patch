+		return;	// wait for Enter
+	}
+	n = 0;
+	for (i = 0; i < end; i++) {
+		a = UART_GetByte(i);
+		if (a == 8 || a == 127) {	// backspace / delete
+			if (n > 0)
+				n--;
+		}
+		else if ((unsigned char)a >= 32 && n < (int)sizeof(tmp) - 1) {
+			tmp[n++] = a;
+		}
+	}
+	tmp[n] = 0;
+	UART_ConsumeBytes(end + 1);
+	if (n > 0)
+		CMD_ExecuteCommand(tmp, 0);
 #endif
 }
