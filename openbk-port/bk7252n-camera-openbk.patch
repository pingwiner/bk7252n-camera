+		g_motActive ? "DETECTED" : "none", g_motChanged / 10, g_motChanged % 10, g_motArea / 10, g_motArea % 10, g_motEvents);
+	hprintf255(request, "<h5>Microphone: %s, level %i (threshold %i), sound %s, %u events - <a href='/audio.wav'>listen</a></h5>",
+		g_audH != DD_HANDLE_UNVALID ? "on" : "off", g_sndRms, g_sndThresh, g_sndActive ? "DETECTED" : "quiet", g_sndEvents);
+}
