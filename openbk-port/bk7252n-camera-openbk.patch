+// BKAudioRec <seconds> - record (mic must be open), then print as hex lines:
+//   AUDDUMP BEGIN <bytes> <rate> / <64 hex chars> ... / AUDDUMP END   (16-bit little-endian mono)
+static commandResult_t CMD_BKAudioRec(const void *context, const char *cmd,
+                                      const char *args, int cmdFlags)
+{
+	int secs = 5;
+	Tokenizer_TokenizeString(args, 0);
+	if (Tokenizer_GetArgsCount() >= 1)
+		secs = Tokenizer_GetArgInteger(0);
+	if (secs < 1) secs = 1;
+	if (secs > 8) secs = 8;
+	if (g_audHdl == DD_HANDLE_UNVALID || g_recState != 0) {
+		ADDLOG_ERROR(LOG_FEATURE_CMD, "BKAudioRec: mic not open or busy");
+		return CMD_RES_ERROR;
+	}
+	g_recLen = (UINT32)secs * BKAUDIO_RATE * 2;
+	g_recBuf = (UINT8 *)os_malloc(g_recLen);
+	if (!g_recBuf) {
+		ADDLOG_ERROR(LOG_FEATURE_CMD, "BKAudioRec: no memory for %u bytes", g_recLen);
+		return CMD_RES_ERROR;
+	}
+	g_recPos = 0;
+	g_recState = 1;
+	ADDLOG_INFO(LOG_FEATURE_CMD, "BKAudioRec: recording %i s", secs);
+	rtos_create_thread(NULL, BEKEN_APPLICATION_PRIORITY, "audrec", BKAudio_RecPrintTask, 2048, NULL);
+	return CMD_RES_OK;
+}
