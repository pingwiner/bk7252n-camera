+// ---- Microphone: /audio.wav stream and sound detection ----------------------------------------
+// The mic is on the BK7252N audio ADC (factory settings: 8 kHz mono, gain 124). A task drains the
+// ADC every 10 ms, applies a digital gain (the raw signal peaks around 1500 of 32767) and keeps
+// the last second in g_aring. HTTP clients follow it with their own read position. The level is
+// measured in 200 ms windows for sound detection.
+#define AUD_RATE        8000
+#define AUD_ADC_RING    2048
+#define AUD_RING        16000              // samples = 2 s of 16-bit audio in 32 KB
+#define AUD_WIN         (AUD_RATE / 5)      // 200 ms
+static UINT8 g_adcRing[AUD_ADC_RING] __attribute__((aligned(4)));
+static short *g_aring;
+static volatile UINT32 g_awr;              // total samples written (ring index = g_awr % AUD_RING)
+static DD_HANDLE g_audH = DD_HANDLE_UNVALID;
+static int g_audGain = 8;                  // digital gain (x)
+static int g_sndThresh = 120;              // RMS after gain that counts as sound (quiet room ~25-40, voice ~200-300)
+static int g_sndHoldWins = 2;              // windows above threshold to trigger (400 ms)
+static int g_sndQuietWins = 15;            // windows below threshold to end (3 s)
+static volatile int g_sndRms, g_sndPeak, g_sndActive;
+static UINT32 g_sndEvents;
+static void Aud_LoadSettings(void);
+
+static void Aud_Event(int active)
+{
+	g_sndActive = active;
+	if (active)
+		g_sndEvents++;
+	ADDLOG_INFO(LOG_FEATURE_DRV, "BKCam: sound %s (rms %i)", active ? "detected" : "ended", g_sndRms);
+#if ENABLE_MQTT
+	MQTT_PublishMain_StringInt("sound", active, 0);
+#endif
+}
+
+static void Aud_Task(beken_thread_arg_t arg)
+{
+	static UINT8 chunk[512] __attribute__((aligned(4)));
+	long long acc = 0;
+	int n = 0, peak = 0, above = 0, below = 0;
+	for (;;) {
+		UINT32 fill = ddev_control(g_audH, AUD_ADC_CMD_GET_FILL_BUF_SIZE, NULL);
+		while (fill >= 2) {
+			UINT32 take = fill > sizeof(chunk) ? sizeof(chunk) : (fill & ~1u);
+			UINT32 got = ddev_read(g_audH, (char *)chunk, take, 0);
+			if (got == 0 || got > take)
+				break;
+			for (UINT32 i = 0; i + 1 < got; i += 2) {
+				int v = (short)(chunk[i] | (chunk[i + 1] << 8)) * g_audGain;
+				if (v > 32767) v = 32767;
+				if (v < -32768) v = -32768;
+				g_aring[g_awr % AUD_RING] = (short)v;
+				g_awr++;
+				acc += (long long)v * v;
+				if ((v < 0 ? -v : v) > peak) peak = v < 0 ? -v : v;
+				if (++n == AUD_WIN) {
+					int r = 0;
+					long long m = acc / n;
+					for (int bit = 1 << 15; bit; bit >>= 1)
+						if ((long long)(r | bit) * (r | bit) <= m) r |= bit;
+					g_sndRms = r; g_sndPeak = peak;
+					if (r >= g_sndThresh) { above++; below = 0; } else { below++; above = 0; }
+					if (!g_sndActive && above >= g_sndHoldWins) Aud_Event(1);
+					if (g_sndActive && below >= g_sndQuietWins) Aud_Event(0);
+					acc = 0; n = 0; peak = 0;
+				}
+			}
+			fill = ddev_control(g_audH, AUD_ADC_CMD_GET_FILL_BUF_SIZE, NULL);
+		}
+		rtos_delay_milliseconds(10);
+	}
+}
+
+static int Aud_Start(void)
+{
+	if (g_audH != DD_HANDLE_UNVALID)
+		return 0;
+	Aud_LoadSettings();
+	if (!g_aring && !(g_aring = (short *)os_malloc(AUD_RING * sizeof(short))))
+		return -1;
+	AUD_ADC_CFG_ST cfg;
+	UINT32 status, vol = 124;
+	os_memset(&cfg, 0, sizeof(cfg));
+	cfg.buf = g_adcRing;
+	cfg.buf_len = AUD_ADC_RING;
+	cfg.inter_thre = AUD_ADC_DEF_WR_THRED;
+	cfg.freq = AUD_RATE;
+	cfg.channels = 1;
+	g_audH = ddev_open(AUD_ADC_DEV_NAME, &status, (UINT32)&cfg);
+	if (g_audH == DD_HANDLE_UNVALID) {
+		ADDLOG_ERROR(LOG_FEATURE_DRV, "BKCam: microphone open failed (%u)", status);
+		return -1;
+	}
+	ddev_control(g_audH, AUD_ADC_CMD_SET_VOLUME, &vol);
+	ddev_control(g_audH, AUD_ADC_CMD_PLAY, NULL);
+	rtos_create_thread(NULL, BEKEN_APPLICATION_PRIORITY, "camaudio", Aud_Task, 2048, NULL);
+	ADDLOG_INFO(LOG_FEATURE_DRV, "BKCam: microphone on, 8 kHz, gain 124 x%i", g_audGain);
+	return 0;
+}
+
+// /audio.wav - endless 8 kHz 16-bit mono WAV (data size 0xFFFFFFFF), starts 0.25 s back
+static int Aud_HttpWav(http_request_t *request)
+{
+	static const char hdr[] = "HTTP/1.1 200 OK\r\nContent-Type: audio/wav\r\nCache-Control: no-store\r\n"
+		"Connection: close\r\n\r\n";
+	UINT8 wav[44];
+	short buf[400];                      // 50 ms
+	if (g_audH == DD_HANDLE_UNVALID && Aud_Start() != 0)
+		return 0;
+	const UINT32 rate = AUD_RATE, byterate = AUD_RATE * 2, big = 0xFFFFFFFF;
+	os_memcpy(wav, "RIFF", 4); os_memcpy(wav + 4, &big, 4); os_memcpy(wav + 8, "WAVEfmt ", 8);
+	UINT32 fmtlen = 16; UINT16 pcm = 1, ch = 1, align = 2, bits = 16;
+	os_memcpy(wav + 16, &fmtlen, 4); os_memcpy(wav + 20, &pcm, 2); os_memcpy(wav + 22, &ch, 2);
+	os_memcpy(wav + 24, &rate, 4); os_memcpy(wav + 28, &byterate, 4); os_memcpy(wav + 32, &align, 2);
+	os_memcpy(wav + 34, &bits, 2); os_memcpy(wav + 36, "data", 4); os_memcpy(wav + 40, &big, 4);
+	if (Cam_SendAll(request->fd, hdr, sizeof(hdr) - 1) || Cam_SendAll(request->fd, wav, 44))
+		return 0;
+	UINT32 rd = g_awr > AUD_RATE / 4 ? g_awr - AUD_RATE / 4 : 0;
+	for (;;) {
+		UINT32 wr = g_awr;
+		if (wr - rd > AUD_RING - AUD_RATE / 4)       // fell too far behind: skip ahead
+			rd = wr - AUD_RATE / 4;
+		if (wr - rd < 400) {
+			rtos_delay_milliseconds(20);
+			continue;
+		}
+		for (int i = 0; i < 400; i++)
+			buf[i] = g_aring[(rd + i) % AUD_RING];
+		rd += 400;
+		if (Cam_SendAll(request->fd, buf, sizeof(buf)))
+			break;
+	}
+	return 0;
+}
+
+
+// Gain and threshold survive restarts in OpenBeken's retained channels (flash vars, 0..11).
+#define AUD_SAVE_GAIN_CH  10
+#define AUD_SAVE_THR_CH   11
+
+static void Aud_LoadSettings(void)
+{
+	int g = HAL_FlashVars_GetChannelValue(AUD_SAVE_GAIN_CH);
+	int t = HAL_FlashVars_GetChannelValue(AUD_SAVE_THR_CH);
+	if (g >= 1 && g <= 32) g_audGain = g;
+	if (t >= 10 && t <= 20000) g_sndThresh = t;
+}
+
+static void Aud_Set(int gain, int thr)
+{
+	if (gain >= 1 && gain <= 32 && gain != g_audGain) {
+		g_audGain = gain;
+		HAL_FlashVars_SaveChannel(AUD_SAVE_GAIN_CH, gain);
+	}
+	if (thr >= 10 && thr <= 20000 && thr != g_sndThresh) {
+		g_sndThresh = thr;
+		HAL_FlashVars_SaveChannel(AUD_SAVE_THR_CH, thr);
+	}
+}
+
+// /camaudio[?gain=N&thr=N] - set (optional) and report the microphone settings and level as JSON
+static int Aud_HttpJson(http_request_t *request)
+{
+	char tmp[16];
+	int g = http_getArg(request->url, "gain", tmp, sizeof(tmp)) ? atoi(tmp) : 0;
+	int t = http_getArg(request->url, "thr", tmp, sizeof(tmp)) ? atoi(tmp) : 0;
+	if (g || t)
+		Aud_Set(g, t);
+	http_setup(request, "application/json");
+	hprintf255(request, "{\"gain\":%i,\"thr\":%i,\"rms\":%i,\"peak\":%i,\"sound\":%i,\"events\":%u,\"mic\":%i}",
+		g_audGain, g_sndThresh, g_sndRms, g_sndPeak, g_sndActive, g_sndEvents, g_audH != DD_HANDLE_UNVALID);
+	poststr(request, NULL);
+	return 0;
+}
+
+// CamAudio [gain] [threshold] - show or set the digital gain and the sound-detection threshold
+static commandResult_t Cam_Cmd_Audio(const void *context, const char *cmd, const char *args, int flags)
+{
+	Tokenizer_TokenizeString(args, 0);
+	Aud_Set(Tokenizer_GetArgsCount() >= 1 ? Tokenizer_GetArgInteger(0) : 0,
+		Tokenizer_GetArgsCount() >= 2 ? Tokenizer_GetArgInteger(1) : 0);
+	ADDLOG_INFO(LOG_FEATURE_CMD, "CamAudio: gain x%i, threshold %i, level rms %i peak %i, sound %i, events %u",
+		g_audGain, g_sndThresh, g_sndRms, g_sndPeak, g_sndActive, g_sndEvents);
+	return CMD_RES_OK;
+}
