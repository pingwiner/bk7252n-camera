+#ifdef CAMERA_GC0329
+#include "gc0329_init_table.h"
+/* camera port: probe and initialise the GC0329. Its chip ID only reads back after register 0xFC
+   (analog/digital enable) is set to 0x16; ID register 0x00 then reads 0xC0. */
+UINT32 g_gc0329_id = 0xFFFFFFFF;
+static int camera_intf_config_gc0329(void)
+{
+    UINT32 i;
+    UINT8 id = 0;
+
+    i2c_operater.salve_id = GC0329_DEV_ID;
+    if (camera_intf_sccb_write(0xFC, 0x16) || camera_intf_sccb_read(0x00, &id))
+    {
+        bk_printf("GC0329: no I2C answer at 0x%02x\r\n", GC0329_DEV_ID);
+        g_gc0329_id = 0xFFFFFF00;
+        return 1;
+    }
+    g_gc0329_id = id;
+    bk_printf("GC0329: id 0x%02x (expect 0xc0)\r\n", id);
+
+    for (i = 0; i < sizeof(gc0329_init_tbl) / 2; i++)
+    {
+        if (camera_intf_sccb_write(gc0329_init_tbl[i][0], gc0329_init_tbl[i][1]))
+        {
+            bk_printf("GC0329: write %u (reg 0x%02x) failed\r\n", i, gc0329_init_tbl[i][0]);
+            return 1;
+        }
+        if (i == 0)
+            delay100us(50);       /* {0xFE,0x80} is a soft reset */
+    }
+    bk_printf("GC0329 init finish (%u regs)\r\n", (unsigned)(sizeof(gc0329_init_tbl) / 2));
+    return 0;
+}
+#endif
