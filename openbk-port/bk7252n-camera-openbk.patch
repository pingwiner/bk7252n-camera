+// ---- Power / Mode buttons (this camera board) -------------------------------------------------
+// Both are active-low with the internal pull-up: Power = GPIO5, Mode = GPIO4 (found with
+// GpioWatch; the factory firmware also wakes from deep sleep on GPIO5, falling edge).
+// Hold Power 2 s -> camera off: stop capture, wait for release, deep sleep with GPIO5 wake-up.
+// Press Power -> the chip wakes and boots; after a button wake the button must still be held when
+// this driver starts, otherwise it goes straight back to sleep (no accidental power-on).
+#define BTN_POWER_GPIO   5
+#define BTN_MODE_GPIO    4
+#define BTN_HOLD_OFF_MS  2000
+#define BTN_POLL_MS      20
+
+static void Btn_ConfigInput(int gpio)
+{
+	REG_WRITE(CAM_GPIO_BASE + 4 * gpio, 0x3C);   // input enable, output off, pull-up
+}
+
+static int Btn_Pressed(int gpio)
+{
+	return (REG_READ(CAM_GPIO_BASE + 4 * gpio) & 1) == 0;
+}
+
+// Deep sleep with wake-up on the Power button (falling edge) and, if rtc_secs > 0, on the RTC
+static void Cam_DeepSleep(UINT32 rtc_secs)
+{
+	rtos_delay_milliseconds(20);
+	PS_DEEP_CTRL_PARAM p;
+	os_memset(&p, 0, sizeof(p));
+	p.gpio_index_map = 1 << BTN_POWER_GPIO;
+	p.gpio_edge_map = 1 << BTN_POWER_GPIO;          // 1 = falling edge (press)
+	p.sleep_mode = MANUAL_MODE_IDLE;
+	p.wake_up_way = PS_DEEP_WAKEUP_GPIO;
+	if (rtc_secs) {
+		p.wake_up_way |= PS_DEEP_WAKEUP_RTC;
+		p.sleep_time = rtc_secs;
+		p.lpo_32k_src = LPO_SELECT_ROSC;
+	}
+	bk_enter_deep_sleep_mode(&p);
+}
+
+static void Cam_PowerOff(void)
+{
+	bk_printf("POWER: off - waiting for the Power button to be released\r\n");
+	Cam_Stop();
+	for (int t = 0; Btn_Pressed(BTN_POWER_GPIO) && t < 10000; t += BTN_POLL_MS)
+		rtos_delay_milliseconds(BTN_POLL_MS);
+	rtos_delay_milliseconds(100);   // let the contact settle
+	bk_printf("POWER: deep sleep, press Power to wake\r\n");
+	Cam_DeepSleep(0);
+}
+
+// Mode held 2 s: forget the Wi-Fi network (same as Config -> WiFi -> "open access point") and
+// restart, so the camera comes back as its open setup AP at 192.168.4.1.
+#define BTN_HOLD_RESET_MS 2000
+static void Btn_WifiReset(void)
+{
+	bk_printf("MODE: held 2 s - forgetting Wi-Fi, restarting as access point\r\n");
+	ADDLOG_INFO(LOG_FEATURE_DRV, "BKCam: Wi-Fi reset by Mode button");
+	CFG_SetWiFiSSID("");
+	CFG_SetWiFiPass("");
+#if ALLOW_SSID2
+	CFG_SetWiFiSSID2("");
+	CFG_SetWiFiPass2("");
+#endif
+	HAL_DisableEnhancedFastConnect();
+	CFG_Save_IfThereArePendingChanges();
+	Cam_Stop();
+	rtos_delay_milliseconds(300);
+	HAL_RebootModule();
+	for (;;)
+		rtos_delay_milliseconds(1000);
+}
+
+static void Btn_Task(beken_thread_arg_t arg)
+{
+	int held = 0, mode_last = 0, mode_held = 0;
+	// The hold that switched the camera on is usually still going on here: only a press that
+	// starts after the button has been released counts towards switching off.
+	int armed = !Btn_Pressed(BTN_POWER_GPIO);
+	for (;;) {
+		if (!armed) {
+			if (!Btn_Pressed(BTN_POWER_GPIO)) {
+				armed = 1;
+				bk_printf("POWER: on (Power button released)\r\n");
+			}
+		} else if (Btn_Pressed(BTN_POWER_GPIO)) {
+			held += BTN_POLL_MS;
+			if (held >= BTN_HOLD_OFF_MS)
+				Cam_PowerOff();
+		} else {
+			held = 0;
+		}
+		int m = Btn_Pressed(BTN_MODE_GPIO);
+		if (m && !mode_last)
+			ADDLOG_INFO(LOG_FEATURE_DRV, "BKCam: Mode button pressed");
+		mode_held = m ? mode_held + BTN_POLL_MS : 0;
+		if (mode_held >= BTN_HOLD_RESET_MS)
+			Btn_WifiReset();
+		mode_last = m;
+		rtos_delay_milliseconds(BTN_POLL_MS);
+	}
+}
+
+static void Btn_Start(void)
+{
+	Btn_ConfigInput(BTN_POWER_GPIO);
+	Btn_ConfigInput(BTN_MODE_GPIO);
+	rtos_delay_milliseconds(2);
+	RESET_SOURCE_STATUS st = bk_misc_get_start_type();
+	bk_printf("POWER: start type %d, Power button %s\r\n", (int)st, Btn_Pressed(BTN_POWER_GPIO) ? "held" : "released");
+	// g_power_btn_hold_ms is measured in entry_main right after the wake (up to 1000 ms):
+	// by the time this driver starts, a deliberate hold has usually ended already.
+	extern int g_power_btn_hold_ms;
+	if (st == RESET_SOURCE_DEEPPS_GPIO)
+		bk_printf("POWER: button held %d ms at wake\r\n", g_power_btn_hold_ms);
+	if (st == RESET_SOURCE_DEEPPS_GPIO && g_power_btn_hold_ms < 1000) {
+		bk_printf("POWER: woken by a short press - back to sleep (hold Power 1 s to switch on)\r\n");
+		Cam_PowerOff();
+	}
+	rtos_create_thread(NULL, BEKEN_APPLICATION_PRIORITY, "buttons", Btn_Task, 1536, NULL);
+}
