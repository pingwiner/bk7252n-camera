+		for (UINT32 i = o; i < g_recPos && i < o + 32; i++) {
+			line[k++] = hx[g_recBuf[i] >> 4];
+			line[k++] = hx[g_recBuf[i] & 15];
+		}
+		line[k++] = '\r'; line[k++] = '\n'; line[k] = 0;
+		bk_printf("%s", line);
+		if ((o & 1023) == 0)
