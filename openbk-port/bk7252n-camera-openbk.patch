+    // BK7252N cameras: the vendor firmware keeps the device's own MAC in its config sector as
+    // JSON ("MAC_ADDR":"C8478C......"); the RF calibration table usually has none, and the
+    // fallback would be the same default MAC on every camera.
+    if(!vendor_cfg_get_mac(mac) &&
