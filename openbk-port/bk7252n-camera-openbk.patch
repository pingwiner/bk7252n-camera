+// /camstatus - audio and motion state in one JSON object (the /cam page polls this once a second)
+static int Cam_HttpStatus(http_request_t *request)
+{
+	http_setup(request, "application/json");
+	hprintf255(request, "{\"a\":{\"gain\":%i,\"thr\":%i,\"rms\":%i,\"peak\":%i,\"sound\":%i,\"events\":%u,\"mic\":%i},",
+		g_audGain, g_sndThresh, g_sndRms, g_sndPeak, g_sndActive, g_sndEvents, g_audH != DD_HANDLE_UNVALID);
+	hprintf255(request, "\"m\":{\"pix\":%i,\"area\":%i,\"changed\":%i,\"motion\":%i,\"events\":%u},",
+		g_motPix, g_motArea, g_motChanged, g_motActive, g_motEvents);
+	hprintf255(request, "\"b\":{\"mv\":%i,\"pct\":%i,\"raw\":%i,\"cutoff\":%i}}",
+		g_batMv, g_batPct, g_batRaw, Bat_CutoffActive() ? g_batCutoff : 0);
+	poststr(request, NULL);
+	return 0;
+}
