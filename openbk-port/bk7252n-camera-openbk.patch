diff -ruN pa3/src/driver/drv_bkCam.c pb3/src/driver/drv_bkCam.c
--- a/src/driver/drv_bkCam.c	1970-01-01 04:00:00.000000000 +0400
+++ b/src/driver/drv_bkCam.c	2026-11-12 23:01:13.610860402 +0400
@@ -0,0 +1,1318 @@
+// BK7252N DVP camera (GC0329 on the security-camera board): JPEG frames from the on-chip encoder,
+// served as /snapshot.jpg, an MJPEG /stream and a /cam page.
+//
+// Beken's camera_intf (SDK func/camera_intf) does the hardware part: sensor clock and DVP pins,
+// I2C1 sensor init, JPEG encoder and the GDMA that drains it. It hands us the JPEG stream in
+// node_len chunks (node_full_handler, from interrupt context) and flags the last chunk of a frame
+// with is_eof. Chunks are copied into one of CAM_NBUF frame buffers; a finished frame becomes the
+// "ready" buffer and HTTP clients send from it while capture continues into another one.
+#include "../obk_config.h"
+
+#if ENABLE_DRIVER_BKCAM
+
+#include "../new_common.h"
+#include "../cmnds/cmd_public.h"
+#include "../httpserver/new_http.h"
+#include "../logging/logging.h"
+#include "drv_local.h"
+#include "../new_cfg.h"
+#include "../hal/hal_wifi.h"
+#include "../hal/hal_generic.h"
+#include "drv_public.h"
+#include "../cmnds/cmd_local.h"
+#include <ctype.h>
+#include <stdlib.h>
+void ScheduleDriverStart(const char *name, int delay);
+#include "../new_pins.h"
+
+#include "include.h"
+#include "arm_arch.h"
+#include "rtos_pub.h"
+#include "mem_pub.h"
+#include "video_transfer.h"
+#include "camera_intf_pub.h"
+#include "lwip/sockets.h"
+#include "manual_ps_pub.h"
+#include "drv_model_pub.h"
+#include "audio_pub.h"
+#include "../mqtt/new_mqtt.h"
+#include "../hal/hal_flashVars.h"
+#include "tjpgd/tjpgd.h"
+#include "start_type_pub.h"
+#include "saradc_pub.h"
+#include "sys_ctrl_pub.h"
+
+#define CAM_NODE_LEN    1024
+#define CAM_RXBUF_LEN   (CAM_NODE_LEN * 8)
+#define CAM_FRAME_MAX   (36 * 1024)       // encoder caps VGA frames at 35 KB (JPEG_BITRATE_MAX_SIZE); typical ~9 KB
+#define CAM_NBUF        3
+
+extern UINT32 g_gc0329_id;
+extern UINT32 camera_intfer_get_senser_reg(UINT16 addr, UINT8 *data);
+extern UINT32 camera_intfer_set_senser_reg(UINT16 addr, UINT8 data);
+
+static UINT8 *g_rx;
+static UINT8 *g_buf[CAM_NBUF];
+static volatile UINT32 g_len[CAM_NBUF];
+static volatile int g_wr = 0;             // buffer being filled
+static volatile int g_ready = -1;         // last complete frame
+static volatile UINT32 g_readers[CAM_NBUF];
+static volatile UINT32 g_frame_id = 0;
+static volatile UINT32 g_overflow = 0, g_badframe = 0, g_chunks = 0;
+static volatile UINT32 g_wpos = 0;
+static int g_running = 0;
+static TVIDEO_DESC_ST g_desc;
+
+static int Cam_PickWriteBuf(void)
+{
+	for (int i = 0; i < CAM_NBUF; i++)
+		if (i != g_ready && g_readers[i] == 0)
+			return i;
+	return -1;
+}
+
+// Interrupt context (GDMA chunk done / end-of-frame timer).
+static void Cam_NodeHandler(void *curptr, UINT32 newlen, UINT32 is_eof, UINT32 frame_len)
+{
+	g_chunks++;
+	if (g_wr < 0) {
+		g_wr = Cam_PickWriteBuf();
+		g_wpos = 0;
+		if (g_wr < 0)
+			return;   // every buffer busy: drop this frame
+	}
+	if (g_wpos + newlen <= CAM_FRAME_MAX) {
+		os_memcpy(g_buf[g_wr] + g_wpos, curptr, newlen);
+		g_wpos += newlen;
+	} else {
+		g_overflow++;
+		g_wpos = CAM_FRAME_MAX + 1;
+	}
+	if (!is_eof)
+		return;
+
+	UINT8 *b = g_buf[g_wr];
+	UINT32 n = g_wpos;
+	int ok = (n <= CAM_FRAME_MAX && n > 4 && b[0] == 0xFF && b[1] == 0xD8);
+	if (ok) {
+		// trim to the EOI marker (the encoder appends a 4-byte size word and DMA padding)
+		UINT32 e = n;
+		while (e >= 2 && !(b[e - 2] == 0xFF && b[e - 1] == 0xD9))
+			e--;
+		ok = e >= 2;
+		n = e;
+	}
+	if (ok) {
+		g_len[g_wr] = n;
+		g_ready = g_wr;
+		g_frame_id++;
+		g_wr = Cam_PickWriteBuf();
+	} else {
+		g_badframe++;
+	}
+	g_wpos = 0;
+}
+
+static void Cam_EndHandler(void) {}
+
+static int Cam_Start(void)
+{
+	if (g_running)
+		return 0;
+	if (!g_rx) {
+		g_rx = (UINT8 *)os_malloc(CAM_RXBUF_LEN);
+		for (int i = 0; i < CAM_NBUF; i++)
+			g_buf[i] = (UINT8 *)os_malloc(CAM_FRAME_MAX);
+		for (int i = 0; i < CAM_NBUF; i++)
+			if (!g_buf[i]) g_rx = NULL;
+		if (!g_rx) {
+			ADDLOG_ERROR(LOG_FEATURE_DRV, "BKCam: out of memory");
+			return -1;
+		}
+	}
+	g_wr = 0; g_wpos = 0; g_ready = -1;
+	os_memset(&g_desc, 0, sizeof(g_desc));
+	g_desc.rxbuf = g_rx;
+	g_desc.rxbuf_len = CAM_RXBUF_LEN;
+	g_desc.node_len = CAM_NODE_LEN;
+	g_desc.node_full_handler = Cam_NodeHandler;
+	g_desc.data_end_handler = Cam_EndHandler;
+	CMPARAM_SET_PPI(g_desc.sener_cfg, VGA_640_480);
+	CMPARAM_SET_FPS(g_desc.sener_cfg, TYPE_10FPS);
+	int r = camera_intfer_init(&g_desc);
+	ADDLOG_INFO(LOG_FEATURE_DRV, "BKCam: camera_intfer_init -> %i, sensor id 0x%x", r, g_gc0329_id);
+	if (r != 1)
+		return r;
+	g_running = 1;
+	return 0;
+}
+
+static void Cam_Stop(void)
+{
+	if (!g_running)
+		return;
+	camera_intfer_deinit();
+	g_running = 0;
+}
+
+// Takes a reference on the newest frame newer than *last; waits up to timeout_ms.
+static int Cam_Acquire(UINT32 *last, int timeout_ms)
+{
+	for (int t = 0; t <= timeout_ms; t += 10) {
+		GLOBAL_INT_DECLARATION();
+		GLOBAL_INT_DISABLE();
+		int r = g_ready;
+		UINT32 id = g_frame_id;
+		if (r >= 0 && id != *last) {
+			g_readers[r]++;
+			*last = id;
+			GLOBAL_INT_RESTORE();
+			return r;
+		}
+		GLOBAL_INT_RESTORE();
+		rtos_delay_milliseconds(10);
+	}
+	return -1;
+}
+
+static void Cam_Release(int i)
+{
+	GLOBAL_INT_DECLARATION();
+	GLOBAL_INT_DISABLE();
+	if (g_readers[i]) g_readers[i]--;
+	if (g_wr < 0) { g_wr = Cam_PickWriteBuf(); g_wpos = 0; }
+	GLOBAL_INT_RESTORE();
+}
+
+static int Cam_SendAll(int fd, const void *p, int len)
+{
+	const char *c = (const char *)p;
+	while (len > 0) {
+		int n = send(fd, c, len, 0);
+		if (n <= 0)
+			return -1;
+		c += n; len -= n;
+	}
+	return 0;
+}
+
+static int Cam_HttpSnapshot(http_request_t *request)
+{
+	char hdr[160];
+	UINT32 last = 0xFFFFFFFF;
+	if (Cam_Start() != 0) {
+		http_setup(request, httpMimeTypeText);
+		poststr(request, "camera not available");
+		poststr(request, NULL);
+		return 0;
+	}
+	int b = Cam_Acquire(&last, 3000);
+	if (b < 0) {
+		http_setup(request, httpMimeTypeText);
+		poststr(request, "no frame from the camera");
+		poststr(request, NULL);
+		return 0;
+	}
+	int n = snprintf(hdr, sizeof(hdr), "HTTP/1.1 200 OK\r\nContent-Type: image/jpeg\r\n"
+		"Content-Length: %u\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n", (unsigned)g_len[b]);
+	if (Cam_SendAll(request->fd, hdr, n) == 0)
+		Cam_SendAll(request->fd, g_buf[b], g_len[b]);
+	Cam_Release(b);
+	return 0;
+}
+
+// CAM_FW_TAG is written by build_camera_fw.sh (version shown on /cam and the main page)
+#if __has_include("drv_bkCam_version.h")
+#include "drv_bkCam_version.h"
+#endif
+#ifndef CAM_FW_TAG
+#define CAM_FW_TAG "fw dev"
+#endif
+#define CAM_BOUNDARY "obkcamframe"
+static int Cam_HttpStream(http_request_t *request)
+{
+	char hdr[160];
+	UINT32 last = 0xFFFFFFFF;
+	if (Cam_Start() != 0)
+		return 0;
+	const char *h = "HTTP/1.1 200 OK\r\nContent-Type: multipart/x-mixed-replace; boundary=" CAM_BOUNDARY
+		"\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n";
+	if (Cam_SendAll(request->fd, h, strlen(h)) != 0)
+		return 0;
+	for (;;) {
+		int b = Cam_Acquire(&last, 3000);
+		if (b < 0)
+			break;
+		int n = snprintf(hdr, sizeof(hdr), "--" CAM_BOUNDARY "\r\nContent-Type: image/jpeg\r\n"
+			"Content-Length: %u\r\n\r\n", (unsigned)g_len[b]);
+		int err = Cam_SendAll(request->fd, hdr, n) || Cam_SendAll(request->fd, g_buf[b], g_len[b])
+			|| Cam_SendAll(request->fd, "\r\n", 2);
+		Cam_Release(b);
+		if (err)
+			break;
+	}
+	return 0;
+}
+
