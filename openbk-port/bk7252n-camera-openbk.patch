+		"function poll(set){if(busy&&!set)return;busy=1;fetch('/camaudio'+(set||'')).then(function(r){return r.json()}).then(function(d){"
+		"show(d);busy=0}).catch(function(){busy=0})}"
+		"g.oninput=t.oninput=function(){show()};"
+		"g.onchange=t.onchange=function(){poll('?gain='+g.value+'&thr='+t.value)};"
+		"var mp=document.getElementById('mp'),ma=document.getElementById('ma'),mbusy=0;"
+		"function mshow(d){document.getElementById('mpv').textContent=mp.value;"
+		"document.getElementById('mav').textContent=(ma.value/10).toFixed(1)+'%';"
+		"var m=Math.max(100,3*ma.value);document.getElementById('mth').style.left=Math.min(100,100*ma.value/m)+'%';"
+		"if(d){document.getElementById('mlv').style.width=Math.min(100,100*d.changed/m)+'%';"
+		"document.getElementById('mlv').style.background=d.motion?'#e94':'#4c8';"
+		"document.getElementById('mst').textContent='changed '+(d.changed/10).toFixed(1)+'%  -  '+(d.motion?'MOTION DETECTED':'no motion')+'  -  '+d.events+' events';}}"
+		"function mpoll(set){if(mbusy&&!set)return;mbusy=1;fetch('/cammotion'+(set||'')).then(function(r){return r.json()}).then(function(d){"
+		"mshow(d);mbusy=0}).catch(function(){mbusy=0})}"
+		"var sbusy=0,first=1;function spoll(){if(sbusy)return;sbusy=1;fetch('/camstatus').then(function(r){return r.json()}).then(function(d){"
+		"if(first||document.activeElement!==g)g.value=d.a.gain;if(first||document.activeElement!==t)t.value=d.a.thr;"
+		"if(first||document.activeElement!==mp)mp.value=d.m.pix;if(first||document.activeElement!==ma)ma.value=d.m.area;first=0;"
+		"show(d.a);mshow(d.m);if(d.b&&d.b.mv>=0)document.getElementById('bat').textContent='battery '+(d.b.mv/1000).toFixed(2)+' V, '+d.b.pct+'% \u00b7 ';sbusy=0}).catch(function(){sbusy=0})}"
+		"mp.oninput=ma.oninput=function(){mshow()};"
+		"mp.onchange=ma.onchange=function(){mpoll('?pix='+mp.value+'&area='+ma.value)};"
+		"spoll();setInterval(spoll,1000);"
+		"</script></body></html>");
+	poststr(request, NULL);
+	return 0;
