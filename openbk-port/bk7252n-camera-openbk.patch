+// PowerOff - same as holding the Power button (for testing)
+static commandResult_t Cam_Cmd_PowerOff(const void *context, const char *cmd, const char *args, int flags)
+{
+	Cam_PowerOff();
+	return CMD_RES_OK;
+}
