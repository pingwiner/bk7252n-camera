+extern void CMD_UARTConsole_Init();
+
+// CamDump - print the newest frame as hex lines over the console UART (for bring-up without Wi-Fi):
+//   CAMDUMP BEGIN <len>
+//   <64 hex chars per line>
+//   CAMDUMP END
+static commandResult_t Cam_Cmd_Dump(const void *context, const char *cmd, const char *args, int flags)
+{
+	UINT32 last = 0xFFFFFFFF;
+	int b = Cam_Acquire(&last, 3000);
+	if (b < 0) {
+		bk_printf("CAMDUMP NONE\r\n");
+		return CMD_RES_ERROR;
+	}
+	static const char hx[] = "0123456789abcdef";
+	char line[70];
+	UINT32 n = g_len[b];
+	bk_printf("CAMDUMP BEGIN %u\r\n", (unsigned)n);
+	for (UINT32 o = 0; o < n; o += 32) {
+		int k = 0;
+		for (UINT32 i = o; i < n && i < o + 32; i++) {
+			line[k++] = hx[g_buf[b][i] >> 4];
+			line[k++] = hx[g_buf[b][i] & 15];
+		}
+		line[k++] = '\r'; line[k++] = '\n'; line[k] = 0;
+		bk_printf("%s", line);
+		if ((o & 1023) == 0)
+			rtos_delay_milliseconds(1);
+	}
+	bk_printf("CAMDUMP END\r\n");
+	Cam_Release(b);
+	return CMD_RES_OK;
+}
+
+int BKCam_SdUpdate(int mode, int verbose);
+void BKCam_SdUpdate_Register(void);
+
+void BKCam_Init(void)
+{
+	// The camera board has no other control path during bring-up: accept console commands on
+	// UART1 (the TX1/RX1 pads), e.g. CamInfo / CamReg. Persisted as an OpenBeken flag.
+	if (!CFG_HasFlag(OBK_FLAG_CMD_ACCEPT_UART_COMMANDS)) {
+		CFG_SetFlag(OBK_FLAG_CMD_ACCEPT_UART_COMMANDS, 1);
+		CFG_Save_IfThereArePendingChanges();
+		CMD_UARTConsole_Init();
+	}
+	HTTP_RegisterCallback("/snapshot.jpg", HTTP_GET, Cam_HttpSnapshot, 0);
+	HTTP_RegisterCallback("/stream", HTTP_GET, Cam_HttpStream, 0);
+	HTTP_RegisterCallback("/cam", HTTP_GET, Cam_HttpPage, 0);
+	HTTP_RegisterCallback("/audio.wav", HTTP_GET, Aud_HttpWav, 0);
+	HTTP_RegisterCallback("/camaudio", HTTP_GET, Aud_HttpJson, 0);
+	HTTP_RegisterCallback("/cammotion", HTTP_GET, Mot_HttpJson, 0);
+	HTTP_RegisterCallback("/camstatus", HTTP_GET, Cam_HttpStatus, 0);
+	//cmddetail:{"name":"CamStart","args":"","descr":"Start the DVP camera and JPEG encoder","fn":"Cam_Cmd_Start","file":"driver/drv_bkCam.c","requires":"","examples":""}
+	CMD_RegisterCommand("CamStart", Cam_Cmd_Start, NULL);
+	//cmddetail:{"name":"CamStop","args":"","descr":"Stop the camera","fn":"Cam_Cmd_Stop","file":"driver/drv_bkCam.c","requires":"","examples":""}
+	CMD_RegisterCommand("CamStop", Cam_Cmd_Stop, NULL);
+	//cmddetail:{"name":"CamInfo","args":"","descr":"Camera status and frame counters","fn":"Cam_Cmd_Info","file":"driver/drv_bkCam.c","requires":"","examples":""}
+	CMD_RegisterCommand("CamInfo", Cam_Cmd_Info, NULL);
+	//cmddetail:{"name":"CamReg","args":"reg [value]","descr":"Read or write a camera sensor register","fn":"Cam_Cmd_Reg","file":"driver/drv_bkCam.c","requires":"","examples":"CamReg 0x00"}
+	CMD_RegisterCommand("CamReg", Cam_Cmd_Reg, NULL);
+	//cmddetail:{"name":"CamDump","args":"","descr":"Print the newest JPEG frame as hex over the console UART","fn":"Cam_Cmd_Dump","file":"driver/drv_bkCam.c","requires":"","examples":""}
+	CMD_RegisterCommand("CamDump", Cam_Cmd_Dump, NULL);
+	//cmddetail:{"name":"GpioWatch","args":"seconds [probe]","descr":"Print GPIO config and log input changes (button finding)","fn":"Cam_Cmd_GpioWatch","file":"driver/drv_bkCam.c","requires":"","examples":"GpioWatch 30 probe"}
+	CMD_RegisterCommand("GpioWatch", Cam_Cmd_GpioWatch, NULL);
+	//cmddetail:{"name":"PowerOff","args":"","descr":"Switch the camera off (deep sleep, wake with the Power button)","fn":"Cam_Cmd_PowerOff","file":"driver/drv_bkCam.c","requires":"","examples":""}
+	CMD_RegisterCommand("PowerOff", Cam_Cmd_PowerOff, NULL);
+	//cmddetail:{"name":"CamAudio","args":"[gain] [threshold]","descr":"Microphone digital gain (x1..x32) and sound-detection RMS threshold; prints the level","fn":"Cam_Cmd_Audio","file":"driver/drv_bkCam.c","requires":"","examples":"CamAudio 8 1500"}
+	CMD_RegisterCommand("CamAudio", Cam_Cmd_Audio, NULL);
+	//cmddetail:{"name":"CamMotion","args":"[sensitivity] [area]","descr":"Video motion detection: grey-level difference 3..128 and changed area in 0.1 % (1..500); prints the state","fn":"Cam_Cmd_Motion","file":"driver/drv_bkCam.c","requires":"","examples":"CamMotion 25 20"}
+	CMD_RegisterCommand("CamMotion", Cam_Cmd_Motion, NULL);
+	//cmddetail:{"name":"CamBattery","args":"[cal mV | cutoff mV]","descr":"Battery voltage; calibrate against a meter reading, or set the deep-sleep cut-off (0 = off)","fn":"Cam_Cmd_Battery","file":"driver/drv_bkCam.c","requires":"","examples":"CamBattery cal 4100"}
+	CMD_RegisterCommand("CamBattery", Cam_Cmd_Battery, NULL);
+	//cmddetail:{"name":"help","args":"[text]","descr":"List console commands, optionally only those containing text","fn":"Cam_Cmd_Help","file":"driver/drv_bkCam.c","requires":"","examples":"help mqtt"}
+	if (!CMD_Find("help"))
+		CMD_RegisterCommand("help", Cam_Cmd_Help, NULL);
+	Btn_Start();
+	Bat_Start();
+	// Firmware update from the microSD card, before the camera and Wi-Fi start (the battery check
+	// above has already put an empty camera back to sleep). Writing takes a few seconds.
+	BKCam_SdUpdate_Register();
+	if (!Bat_CutoffActive() || g_batMv >= g_batCutoff + 150) {
+		if (BKCam_SdUpdate(1, 0)) {
+			rtos_delay_milliseconds(300);
+			HAL_RebootModule();
+		}
+	} else {
+		ADDLOG_INFO(LOG_FEATURE_CMD, "SD update: skipped, battery %d mV is too low", g_batMv);
+	}
+	// Discovery, so the camera can be found without the router's client list: mDNS answers
+	// <short name>.local and announces an _http._tcp service (macOS/iOS/Windows/Linux, Android
+	// service browsers); SSDP lists it under Network in Windows Explorer. Both wait for Wi-Fi.
+	// (BKCam_Init runs under the driver lock, so DRV_StartDriver here would fail: schedule them.)
+#if ENABLE_DRIVER_MDNS
+	ScheduleDriverStart("MDNS", 2);
+#endif
+#if ENABLE_DRIVER_SSDP && BKCAM_START_SSDP
+	ScheduleDriverStart("SSDP", 2);
+#endif
+	Cam_Start();
+	Aud_Start();
+	Mot_Start();
+}
