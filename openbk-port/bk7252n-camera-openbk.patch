@@ -105,13 +105,69 @@
 }
 #endif
 
+#if (CFG_SOC_NAME == SOC_BK7252N)
+// Look for "MAC_ADDR":"<12 hex digits>" in the vendor config sectors (physical flash 0x1F4000
+// and its copy at 0x1F6000). Only the MAC field is parsed.
+static int hexval(char c)
+{
+    if(c >= '0' && c <= '9') return c - '0';
+    if(c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if(c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static int vendor_cfg_get_mac(u8 *mac)
+{
+    static const UINT32 addrs[] = { 0x1F4000, 0x1F6000 };
+    static const char key[] = "\"MAC_ADDR\":\"";
+    char buf[96];
+    UINT32 a, off;
+    int k, i;
+
+    for(k = 0; k < 2; k++) {
+        // the key sits near the start of the JSON; scan the first 512 bytes in overlapping chunks
+        for(off = 0; off < 512; off += 64) {
+            a = addrs[k] + off;
+            flash_read(buf, sizeof(buf), a);
+            for(i = 0; i + (int)sizeof(key) - 1 + 12 <= (int)sizeof(buf); i++) {
+                if(os_memcmp(buf + i, key, sizeof(key) - 1) == 0) {
+                    char *h = buf + i + sizeof(key) - 1;
+                    int j, ok = 1;
+                    u8 m[6];
+                    for(j = 0; j < 6; j++) {
+                        int hi = hexval(h[2 * j]), lo = hexval(h[2 * j + 1]);
+                        if(hi < 0 || lo < 0) { ok = 0; break; }
+                        m[j] = (u8)(hi << 4 | lo);
+                    }
+                    if(ok && !(m[0] & 0x01) && (m[0] | m[1] | m[2] | m[3] | m[4] | m[5])) {
+                        os_memcpy(mac, m, 6);
+                        os_printf("vendor cfg MAC %02X:%02X:%02X:%02X:%02X:%02X (0x%x)\r\n",
+                                  m[0], m[1], m[2], m[3], m[4], m[5], a + i);
+                        return 1;
+                    }
+                }
+            }
+        }
+    }
+    return 0;
+}
+#endif
+
