+
+// ---- Motion detection from the video ----------------------------------------------------------
+// No PIR on this camera, so motion comes from the picture: every MOT_PERIOD_MS the newest JPEG is
+// decoded at 1/8 scale (80x60 grey; TJpgDec only needs the DC coefficient per block for that) and
+// compared with a slowly updated background. The overall brightness change is subtracted first
+// (auto exposure). Pixels differing by more than g_motPix count as changed; at least g_motArea
+// tenths of a percent changed in two analyses in a row = motion; 5 s without = motion ended.
+#define MOT_W 80
+#define MOT_H 60
+#define MOT_N (MOT_W * MOT_H)
+#define MOT_PERIOD_MS 500
+#define MOT_SAVE_PIX_CH   8
+#define MOT_SAVE_AREA_CH  9
+static int g_motPix = 25;          // grey-level difference that counts as a change (0..255)
+static int g_motArea = 20;         // changed area that counts as motion, in 0.1 % (20 = 2 %)
+static volatile int g_motChanged;  // last changed area, 0.1 %
+static volatile int g_motActive;
+static UINT32 g_motEvents, g_motFrames, g_motErrors;
+static UINT8 *g_motCur;
+static UINT16 *g_motBg;            // background x16
+static int g_motBgValid;
+
+// The encoder puts a 0xFF fill byte before some markers (legal, but TJpgDec rejects it): the
+// header up to SOS is copied without fill bytes, the entropy-coded data is read in place.
+typedef struct { UINT8 hdr[1024]; UINT32 hlen; const UINT8 *body; UINT32 blen, pos; } MotSrc;
+
+static int Mot_CleanHeader(MotSrc *m, const UINT8 *d, UINT32 n)
+{
+	UINT32 i = 2, o = 2;
+	if (n < 4 || d[0] != 0xFF || d[1] != 0xD8) return -1;
+	m->hdr[0] = 0xFF; m->hdr[1] = 0xD8;
+	while (i + 4 < n) {
+		if (d[i] != 0xFF) return -2;
+		while (i + 1 < n && d[i + 1] == 0xFF) i++;
+		UINT32 mk = d[i + 1], L = (d[i + 2] << 8) | d[i + 3];
+		if (o + 2 + L > sizeof(m->hdr) || i + 2 + L > n) return -3;
+		os_memcpy(m->hdr + o, d + i, 2 + L);
+		o += 2 + L; i += 2 + L;
+		if (mk == 0xDA) { m->hlen = o; m->body = d + i; m->blen = n - i; m->pos = 0; return 0; }
+	}
+	return -4;
+}
+
+static size_t Mot_In(JDEC *jd, uint8_t *buf, size_t n)
+{
+	MotSrc *m = (MotSrc *)jd->device;
+	size_t done = 0;
+	while (n) {
+		size_t k;
+		if (m->pos < m->hlen) {
+			k = m->hlen - m->pos; if (k > n) k = n;
+			if (buf) os_memcpy(buf, m->hdr + m->pos, k);
+		} else {
+			UINT32 b = m->pos - m->hlen;
+			if (b >= m->blen) break;
+			k = m->blen - b; if (k > n) k = n;
+			if (buf) os_memcpy(buf, m->body + b, k);
+		}
+		m->pos += k; n -= k; done += k;
+		if (buf) buf += k;
+	}
+	return done;
+}
+
+static int Mot_Out(JDEC *jd, void *bmp, JRECT *r)
+{
+	UINT8 *p = (UINT8 *)bmp;
+	for (int y = r->top; y <= r->bottom && y < MOT_H; y++)
+		for (int x = r->left; x <= r->right; x++, p++)
+			if (x < MOT_W) g_motCur[y * MOT_W + x] = *p;
+	return 1;
+}
+
+static void Mot_Event(int active)
+{
+	g_motActive = active;
+	if (active) g_motEvents++;
+	ADDLOG_INFO(LOG_FEATURE_DRV, "BKCam: motion %s (%i.%i %% changed)", active ? "detected" : "ended",
+		g_motChanged / 10, g_motChanged % 10);
+#if ENABLE_MQTT
+	MQTT_PublishMain_StringInt("motion", active, 0);
+#endif
+}
+
+static void Mot_Task(beken_thread_arg_t arg)
+{
+	static MotSrc src;
+	static UINT8 work[3600] __attribute__((aligned(4)));
+	UINT32 last = 0xFFFFFFFF;
+	int hits = 0, quiet = 0;
+	for (;;) {
+		rtos_delay_milliseconds(MOT_PERIOD_MS);
+		if (!g_running)
+			continue;
+		int b = Cam_Acquire(&last, 1000);
+		if (b < 0)
+			continue;
+		JDEC jd;
+		int ok = Mot_CleanHeader(&src, g_buf[b], g_len[b]) == 0
+			&& jd_prepare(&jd, Mot_In, work, sizeof(work), &src) == JDR_OK
+			&& jd.width == MOT_W * 8 && jd.height == MOT_H * 8
+			&& jd_decomp(&jd, Mot_Out, 3) == JDR_OK;
+		Cam_Release(b);
+		if (!ok) { g_motErrors++; continue; }
+		g_motFrames++;
+		if (!g_motBgValid) {
+			for (int i = 0; i < MOT_N; i++) g_motBg[i] = g_motCur[i] << 4;
+			g_motBgValid = 1;
+			continue;
+		}
+		// brightness shift between frame and background (auto exposure), x16
+		long sum = 0;
+		for (int i = 0; i < MOT_N; i++) sum += (g_motCur[i] << 4) - g_motBg[i];
+		int shift = (int)(sum / MOT_N);
+		int changed = 0, lim = g_motPix << 4;
+		for (int i = 0; i < MOT_N; i++) {
+			int d = (g_motCur[i] << 4) - g_motBg[i] - shift;
+			if (d > lim || d < -lim) changed++;
+			g_motBg[i] += ((g_motCur[i] << 4) - g_motBg[i]) / 8;   // ~4 s time constant
+		}
+		g_motChanged = changed * 1000 / MOT_N;
+		if (g_motChanged >= g_motArea) { hits++; quiet = 0; } else { quiet++; hits = 0; }
+		if (!g_motActive && hits >= 2) Mot_Event(1);
+		if (g_motActive && quiet >= 5000 / MOT_PERIOD_MS) Mot_Event(0);
+	}
+}
+
+static void Mot_Set(int pix, int area)
+{
+	if (pix >= 3 && pix <= 128 && pix != g_motPix) {
+		g_motPix = pix;
+		HAL_FlashVars_SaveChannel(MOT_SAVE_PIX_CH, pix);
+	}
+	if (area >= 1 && area <= 500 && area != g_motArea) {
+		g_motArea = area;
+		HAL_FlashVars_SaveChannel(MOT_SAVE_AREA_CH, area);
+	}
+}
+
+static void Mot_Start(void)
+{
+	int p = HAL_FlashVars_GetChannelValue(MOT_SAVE_PIX_CH);
+	int a = HAL_FlashVars_GetChannelValue(MOT_SAVE_AREA_CH);
+	if (p >= 3 && p <= 128) g_motPix = p;
+	if (a >= 1 && a <= 500) g_motArea = a;
+	g_motCur = (UINT8 *)os_malloc(MOT_N);
+	g_motBg = (UINT16 *)os_malloc(MOT_N * sizeof(UINT16));
+	if (!g_motCur || !g_motBg) {
+		ADDLOG_ERROR(LOG_FEATURE_DRV, "BKCam: motion detection - out of memory");
+		return;
+	}
+	rtos_create_thread(NULL, BEKEN_APPLICATION_PRIORITY, "cammotion", Mot_Task, 3072, NULL);
+	ADDLOG_INFO(LOG_FEATURE_DRV, "BKCam: motion detection on (sensitivity %i, area %i.%i %%)",
+		g_motPix, g_motArea / 10, g_motArea % 10);
+}
+
+// /cammotion[?pix=N&area=N] - set (optional) and report motion detection as JSON
+static int Mot_HttpJson(http_request_t *request)
+{
+	char tmp[16];
+	int p = http_getArg(request->url, "pix", tmp, sizeof(tmp)) ? atoi(tmp) : 0;
+	int a = http_getArg(request->url, "area", tmp, sizeof(tmp)) ? atoi(tmp) : 0;
+	if (p || a)
+		Mot_Set(p, a);
+	http_setup(request, "application/json");
+	hprintf255(request, "{\"pix\":%i,\"area\":%i,\"changed\":%i,\"motion\":%i,\"events\":%u,\"frames\":%u,\"errors\":%u}",
+		g_motPix, g_motArea, g_motChanged, g_motActive, g_motEvents, g_motFrames, g_motErrors);
+	poststr(request, NULL);
+	return 0;
+}
+
+
+// ---- Battery: VBAT on SAR ADC channel 0 ---------------------------------------------------------
+// The SAR ADC reads VBAT through an on-chip divider. The pin voltage comes from the SDK's
+// calibration (saradc_calculate: 0.2 V + 1.8 V * (raw - low) / (high - low)); g_batScale (per
+// mille) turns it into the battery voltage and can be calibrated with "CamBattery cal <mV>".
+// A task reads it every 10 s and publishes <client>/battery (mV) and battery_pct every minute.
+// Below the cut-off for 3 readings in a row the camera goes to deep sleep instead of browning out
+// at the next Wi-Fi burst (which ends in a reboot loop); it wakes on the Power button, or every
+// 30 min to check again (charging on USB brings it back up by itself).
+#define BAT_SAVE_SCALE_CH   6       // retained channels are 0..11 only
+#define BAT_SAVE_CUTOFF_CH  7
+#define BAT_SAMPLES         32
+#define BAT_PERIOD_MS       10000
+#define BAT_RECHECK_S       1800
+#ifndef BAT_DEFAULT_SCALE
+#define BAT_DEFAULT_SCALE   2995           // per mille, battery mV = pin mV * scale / 1000 (metered 3.58 V at 1.195 V pin: ~1/3 divider)
+#endif
+#ifndef BAT_SCALE_TRUSTED
+#define BAT_SCALE_TRUSTED   1              // default scale checked on this board -> cut-off active
+#endif
+#define BAT_DEFAULT_CUTOFF  3450
+static saradc_desc_t g_batDesc;
+static UINT16 g_batBuf[BAT_SAMPLES];
+static volatile DD_HANDLE g_batHdl = DD_HANDLE_UNVALID;
+static beken_semaphore_t g_batSem;
+static int g_batScale = BAT_DEFAULT_SCALE, g_batScaleOk = BAT_SCALE_TRUSTED;
+static int g_batCutoff = BAT_DEFAULT_CUTOFF;
+static volatile int g_batRaw, g_batPinMv, g_batMv = -1, g_batPct = -1, g_batLow;
+static UINT32 g_batOk, g_batErr[4];
+
+static void Bat_AdcDone(void)
+{
+	if (g_batDesc.current_sample_data_cnt >= g_batDesc.data_buff_size) {
+		ddev_close(g_batHdl);
+		saradc_ensure_close();
+		g_batHdl = DD_HANDLE_UNVALID;
+		rtos_set_semaphore(&g_batSem);
+	}
+}
+
+// raw ADC code averaged over the last 3/4 of BAT_SAMPLES conversions, or < 0 on error
+static int Bat_ReadRaw(void)
+{
+	UINT32 status;
+	if (!g_batSem && rtos_init_semaphore(&g_batSem, 1) != kNoErr)
+		return -1;
+	for (int tries = 0; tries < 10; tries++) {
+		os_memset(g_batBuf, 0, sizeof(g_batBuf));
+		saradc_config_param_init(&g_batDesc);
+		g_batDesc.channel = 0;                     // VBAT
+		g_batDesc.pData = g_batBuf;
+		g_batDesc.data_buff_size = BAT_SAMPLES;
+		g_batDesc.p_Int_Handler = Bat_AdcDone;
+		GLOBAL_INT_DECLARATION();
+		GLOBAL_INT_DISABLE();
+		g_batHdl = ddev_open(SARADC_DEV_NAME, &status, (UINT32)&g_batDesc);
+		GLOBAL_INT_RESTORE();
+		if (g_batHdl == DD_HANDLE_UNVALID) {       // ADC busy (e.g. temperature check): retry
+			rtos_delay_milliseconds(20);
+			continue;
+		}
+		if (rtos_get_semaphore(&g_batSem, 500) != kNoErr) {
+			g_batErr[2]++;
+			GLOBAL_INT_DISABLE();
+			if (g_batHdl != DD_HANDLE_UNVALID) {
+				ddev_close(g_batHdl);
+				saradc_ensure_close();
+				g_batHdl = DD_HANDLE_UNVALID;
+			}
+			GLOBAL_INT_RESTORE();
+			return -2;
+		}
+		UINT32 sum = 0;
+		for (int i = BAT_SAMPLES / 4; i < BAT_SAMPLES; i++)
+			sum += g_batBuf[i];
+		return sum / (BAT_SAMPLES - BAT_SAMPLES / 4);
+	}
+	g_batErr[3]++;
+	return -3;
+}
+
+static int Bat_Percent(int mv)
+{
+	// Li-ion open-circuit curve (rough): mV -> %
+	static const short tab[][2] = { {4150, 100}, {4050, 90}, {3950, 80}, {3870, 70}, {3800, 60},
+		{3750, 50}, {3710, 40}, {3680, 30}, {3640, 20}, {3580, 10}, {3450, 0} };
+	if (mv >= tab[0][0]) return 100;
+	for (int i = 1; i < (int)(sizeof(tab) / sizeof(tab[0])); i++)
+		if (mv >= tab[i][0])
+			return tab[i][1] + (tab[i - 1][1] - tab[i][1]) * (mv - tab[i][0]) / (tab[i - 1][0] - tab[i][0]);
+	return 0;
+}
+
+// one measurement: updates g_batRaw / g_batPinMv / g_batMv / g_batPct; returns mV or < 0
+static int Bat_Measure(void)
+{
+	int raw = Bat_ReadRaw();
+	if (raw < 0)
+		return raw;
+	g_batOk++;
+	g_batRaw = raw;
+	g_batPinMv = (int)(saradc_calculate((UINT16)raw) * 1000.0f);
+	int mv = g_batPinMv * g_batScale / 1000;
+	g_batMv = (g_batMv < 0) ? mv : (g_batMv * 3 + mv) / 4;   // light smoothing (Wi-Fi bursts)
+	g_batPct = Bat_Percent(g_batMv);
+	return g_batMv;
+}
+
+// is the reading usable for the cut-off? (a wrong scale must not put the camera to sleep)
+static int Bat_CutoffActive(void)
+{
+	return g_batScaleOk && g_batCutoff > 0 && g_batMv > 2500 && g_batMv < 4600;
+}
+
+static void Bat_Sleep(void)
+{
+	bk_printf("BATTERY: %d mV is below %d mV - deep sleep (Power button or %d min re-check)\r\n",
+		g_batMv, g_batCutoff, BAT_RECHECK_S / 60);
+	MQTT_PublishMain_StringInt("battery_low", 1, 0);
+	rtos_delay_milliseconds(500);
+	Cam_Stop();
+	Cam_DeepSleep(BAT_RECHECK_S);
+}
+
+static void Bat_Task(beken_thread_arg_t arg)
+{
+	int below = 0, n = 0;
+	for (;;) {
+		int mv = Bat_Measure();
+		if ((n % 6) == 0)
+			bk_printf("BATTERY: %d mV (%d %%), raw %d, pin %d mV, ok %u, err busy %u / timeout %u, last %d\r\n",
+				g_batMv, g_batPct, g_batRaw, g_batPinMv, g_batOk, g_batErr[3], g_batErr[2], mv);
+		if (mv >= 0 && (n % 6) == 0) {
+			ADDLOG_INFO(LOG_FEATURE_DRV, "BKCam: battery %i mV (%i %%), raw %i, pin %i mV, cal %x/%x",
+				g_batMv, g_batPct, g_batRaw, g_batPinMv, saradc_val.low, saradc_val.high);
+			MQTT_PublishMain_StringInt("battery", g_batMv, 0);
+			MQTT_PublishMain_StringInt("battery_pct", g_batPct, 0);
+		}
+		n++;
+		if (mv >= 0 && Bat_CutoffActive() && mv < g_batCutoff) {
+			if (++below >= 3)
+				Bat_Sleep();
+		} else {
+			below = 0;
+		}
+		rtos_delay_milliseconds(BAT_PERIOD_MS);
+	}
+}
+
+static void Bat_Start(void)
+{
+	int s = HAL_FlashVars_GetChannelValue(BAT_SAVE_SCALE_CH);
+	int c = HAL_FlashVars_GetChannelValue(BAT_SAVE_CUTOFF_CH);
+	if (s >= 500 && s <= 8000) { g_batScale = s; g_batScaleOk = 1; }
+	if (c == -1) g_batCutoff = 0;                            // saved as "off"
+	else if (c >= 2800 && c <= 4000) g_batCutoff = c;
+	// Check once before the camera and Wi-Fi load the battery: an empty battery goes straight
+	// back to sleep instead of resetting at the first radio burst.
+	for (int i = 0; i < 3; i++)
+		Bat_Measure();
+	bk_printf("BATTERY: %d mV (%d %%), raw %d, pin %d mV, scale %d%s, cut-off %d mV%s\r\n",
+		g_batMv, g_batPct, g_batRaw, g_batPinMv, g_batScale, g_batScaleOk ? "" : " (uncalibrated)",
+		g_batCutoff, Bat_CutoffActive() ? "" : " (inactive)");
+	if (Bat_CutoffActive() && g_batMv < g_batCutoff)
+		Bat_Sleep();
+	rtos_create_thread(NULL, BEKEN_APPLICATION_PRIORITY, "battery", Bat_Task, 1536, NULL);
+}
+
+// help [text] -> list all console commands (or those containing <text>), several per line.
+// OpenBeken has no command list of its own; the factory RT-Thread shell's help/ls are gone.
+typedef struct { const char *filter; const char **names; int count, max; } helpList_t;
+
+static int Help_Match(const char *name, const char *f)
+{
+	if (!f || !*f)
+		return 1;
+	for (; *name; name++) {
+		const char *a = name, *b = f;
+		while (*a && *b && tolower((unsigned char)*a) == tolower((unsigned char)*b)) { a++; b++; }
+		if (!*b)
+			return 1;
+	}
+	return 0;
+}
+
+static void Help_Add(command_t *c, void *ud)
+{
+	helpList_t *h = (helpList_t *)ud;
+	if (Help_Match(c->name, h->filter) && h->count < h->max)
+		h->names[h->count++] = c->name;
+}
+
+static int Help_Cmp(const void *a, const void *b)
+{
+	return stricmp(*(const char **)a, *(const char **)b);
+}
+
+static commandResult_t Cam_Cmd_Help(const void *context, const char *cmd, const char *args, int flags)
+{
+	helpList_t h;
+	char line[100];
+	int len = 0, i;
+	os_memset(&h, 0, sizeof(h));
+	Tokenizer_TokenizeString(args, 0);
+	if (Tokenizer_GetArgsCount() >= 1)
+		h.filter = Tokenizer_GetArg(0);
+	h.max = 400;
+	h.names = (const char **)os_malloc(h.max * sizeof(char *));
+	if (!h.names)
+		return CMD_RES_ERROR;
+	if (!h.filter)
+		ADDLOG_INFO(LOG_FEATURE_CMD, "Camera: CamInfo CamStart CamStop CamReg CamDump CamAudio CamMotion CamBattery SdUpdate PowerOff GpioWatch");
+	CMD_ListAllCommands(&h, Help_Add);
+	qsort(h.names, h.count, sizeof(char *), Help_Cmp);
+	for (i = 0; i < h.count; i++) {
+		int n = strlen(h.names[i]);
+		if (len && len + 1 + n >= (int)sizeof(line) - 1) {
+			ADDLOG_INFO(LOG_FEATURE_CMD, "%s", line);
+			len = 0;
+		}
+		len += snprintf(line + len, sizeof(line) - len, "%s%s", len ? " " : "", h.names[i]);
+	}
+	if (len)
+		ADDLOG_INFO(LOG_FEATURE_CMD, "%s", line);
+	ADDLOG_INFO(LOG_FEATURE_CMD, "%i commands%s%s. 'help <text>' filters, e.g. help mqtt",
+		h.count, h.filter ? " matching " : "", h.filter ? h.filter : "");
+	os_free(h.names);
+	return CMD_RES_OK;
+}
+
+// CamBattery                -> print the reading
+// CamBattery cal <mV>       -> calibrate: the battery voltage measured with a meter right now
+// CamBattery cutoff <mV|0>  -> deep-sleep threshold (0 = off)
+static commandResult_t Cam_Cmd_Battery(const void *context, const char *cmd, const char *args, int flags)
+{
+	bk_printf("CamBattery: '%s'\r\n", args ? args : "");
+	Tokenizer_TokenizeString(args, 0);
+	if (Tokenizer_GetArgsCount() >= 2) {
+		const char *what = Tokenizer_GetArg(0);
+		int v = Tokenizer_GetArgInteger(1);
+		if (!stricmp(what, "cal")) {
+			int raw = Bat_ReadRaw();
+			if (raw < 0 || v < 2500 || v > 4600) {
+				bk_printf("CamBattery: cal failed (adc %d, value %d)\r\n", raw, v);
+				return CMD_RES_BAD_ARGUMENT;
+			}
+			int pin = (int)(saradc_calculate((UINT16)raw) * 1000.0f);
+			if (pin <= 0)
+				return CMD_RES_ERROR;
+			g_batScale = v * 1000 / pin;
+			g_batScaleOk = 1;
+			g_batMv = -1;
+			HAL_FlashVars_SaveChannel(BAT_SAVE_SCALE_CH, g_batScale);
+		} else if (!stricmp(what, "cutoff")) {
+			if (v != 0 && (v < 2800 || v > 4000))
+				return CMD_RES_BAD_ARGUMENT;
+			g_batCutoff = v;
+			HAL_FlashVars_SaveChannel(BAT_SAVE_CUTOFF_CH, v ? v : -1);
+		} else {
+			return CMD_RES_BAD_ARGUMENT;
+		}
+	}
+	Bat_Measure();
+	bk_printf("CamBattery: %d mV, raw %d, pin %d mV, scale %d\r\n", g_batMv, g_batRaw, g_batPinMv, g_batScale);
+	ADDLOG_INFO(LOG_FEATURE_CMD, "CamBattery: %i mV (%i %%), raw %i, pin %i mV, scale %i%s, cut-off %i mV%s, cal %x/%x",
+		g_batMv, g_batPct, g_batRaw, g_batPinMv, g_batScale, g_batScaleOk ? "" : " (uncalibrated)",
+		g_batCutoff, Bat_CutoffActive() ? "" : " (inactive)", saradc_val.low, saradc_val.high);
+	return CMD_RES_OK;
+}
