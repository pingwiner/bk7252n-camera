From a826776b2230b1e966556eb1eac8889498f22f80 Mon Sep 17 00:00:00 2001
From: im486dx <im486dx@gmail.com>
Date: Mon, 9 Nov 2026 19:33:39 +0400
Subject: [PATCH] camera_intf: build on BK7252N and add GC0329/GC0329C support

beken_src.mk only added func/camera_intf to the build under
`ifeq ($CFG_USE_CAMERA_INTF), 1)`. That line is malformed, and
CFG_USE_CAMERA_INTF is a C define from sys_config_*.h rather than a make
variable, so the camera interface was never compiled. Build camera_intf.c
on BK7252N, whose jpeg.c and i2c1_bk7252n.c it uses; the file still guards
itself with #if CFG_USE_CAMERA_INTF.

camera_intfer_init() now probes for a GalaxyCore GC0329 / GC0329C
(I2C 0x31, chip ID 0xC0 in register 0x00 once 0xFC = 0x16) before the
compile-time USE_CAMERA sensor. When found, it is configured from
gc0329_init_table.h (640x480 YUYV); otherwise the USE_CAMERA path runs as
before. The ID read is retried because the sensor does not answer in the
first milliseconds after MCLK starts. CAMERA_GC0329_PROBE=0 disables it.

Tested on a BK7252N battery camera (TH25Q-16HB flash, GC0329C sensor):
640x480 JPEG at 10 fps through the BK7252N JPEG encoder and GDMA.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01N5nR5M1QDLE8VphuUB9JX4
---
 beken378/beken_src.mk                         |  6 +++
 beken378/func/camera_intf/camera_intf.c       | 52 ++++++++++++++++++
 .../func/camera_intf/camera_intf_config.h     |  9 ++++
 beken378/func/camera_intf/gc0329_init_table.h | 53 +++++++++++++++++++
 4 files changed, 120 insertions(+)
 create mode 100644 beken378/func/camera_intf/gc0329_init_table.h

diff --git a/beken378/beken_src.mk b/beken378/beken_src.mk
index 079bb46..aa53166 100644
--- a/beken378/beken_src.mk
+++ b/beken378/beken_src.mk
@@ -626,6 +626,12 @@ SRC_FUNC_C += ./beken378/func/wlan_ui/bk_peripheral_test.c
 SRC_FUNC_C += ./beken378/func/utf8/conv_utf8.c
 
 # video / jpeg
+# CFG_USE_CAMERA_INTF is a C define (sys_config_*.h), not a make variable, so the condition below
+# is never true. camera_intf.c guards itself with #if CFG_USE_CAMERA_INTF; build it on BK7252N,
+# whose jpeg.c and i2c1_bk7252n.c it needs.
+ifeq ($(CFG_SOC_NAME),$(SOC_BK7252N))
+SRC_FUNC_C += ./beken378/func/camera_intf/camera_intf.c
+endif
 ifeq ($CFG_USE_CAMERA_INTF), 1)
 SRC_FUNC_C += ./beken378/func/camera_intf/camera_intf.c
 SRC_FUNC_C += ./beken378/func/camera_intf/camera_intf_gc2145.c
diff --git a/beken378/func/camera_intf/camera_intf.c b/beken378/func/camera_intf/camera_intf.c
index 5719637..10f71a8 100644
--- a/beken378/func/camera_intf/camera_intf.c
+++ b/beken378/func/camera_intf/camera_intf.c
@@ -327,6 +327,47 @@ int camera_intf_sccb_read(UINT16 addr, UINT8 *data)
 }
 #endif
 
+#if CAMERA_GC0329_PROBE
+#include "gc0329_init_table.h"
+/* Returns 0 when a GC0329 was found and configured, 1 when there is none (caller falls back to
+   USE_CAMERA), 2 when one was found but writing its table failed. The chip ID only reads back
+   after register 0xFC (analog/digital enable) is set to 0x16, and not in the first few ms after
+   MCLK starts, so the probe is retried. */
+static int camera_intf_config_gc0329(void)
+{
+    UINT32 i;
+    UINT8 id = 0;
+
+    i2c_operater.salve_id = GC0329_DEV_ID;
+    for (i = 0; i < 5; i++)
+    {
+        if ((camera_intf_sccb_write(0xFC, 0x16) == 0) && (camera_intf_sccb_read(0x00, &id) == 0)
+            && (id == GC0329_CHIP_ID))
+            break;
+        delay100us(100);    /* 10 ms */
+    }
+    if (id != GC0329_CHIP_ID)
+    {
+        return 1;
+    }
+
+    for (i = 0; i < sizeof(gc0329_init_tbl) / 2; i++)
+    {
+        if (camera_intf_sccb_write(gc0329_init_tbl[i][0], gc0329_init_tbl[i][1]))
+        {
+            CAMERA_INTF_WPRT("GC0329 init failed at %d\r\n", i);
+            return 2;
+        }
+        if (i == 0)
+        {
+            delay100us(50);  /* {0xFE, 0x80}: soft reset */
+        }
+    }
+    CAMERA_INTF_WPRT("GC0329 init finish\r\n");
+    return 0;
+}
+#endif
+
 #if (USE_CAMERA == GC0328C_DEV)
 static int camera_inf_cfg_gc0328c_ppi(UINT32 ppi_type)
 {
@@ -768,7 +809,18 @@ int camera_intfer_init(void *data)
         goto init_exit;
     }
 
+#if CAMERA_GC0329_PROBE
+    int gc0329 = camera_intf_config_gc0329();
+    if (gc0329 == 2)
+    {
+        fail = -2;
+        bk_printf("config_senser failed \r\n");
+        goto init_exit;
+    }
+    if((gc0329 != 0) && (camera_intf_config_senser() != 0))
+#else
     if(camera_intf_config_senser() != 0)
+#endif
     {
         fail = -2;
         bk_printf("config_senser failed \r\n");
diff --git a/beken378/func/camera_intf/camera_intf_config.h b/beken378/func/camera_intf/camera_intf_config.h
index e05c5c5..f475744 100644
--- a/beken378/func/camera_intf/camera_intf_config.h
+++ b/beken378/func/camera_intf/camera_intf_config.h
@@ -51,5 +51,14 @@
 #define HM_1055_DEV_ID          (0x24)      //slave_address:0x48
 #define GC_2145_DEV_ID          (0x3C)      //slave_address:0x78
 
+/* GC0329 / GC0329C is detected at run time, ahead of USE_CAMERA: if a sensor at GC0329_DEV_ID
+   reports GC0329_CHIP_ID it gets gc0329_init_table.h, otherwise USE_CAMERA is configured as before.
+   Set CAMERA_GC0329_PROBE to 0 to skip the probe. */
+#ifndef CAMERA_GC0329_PROBE
+#define CAMERA_GC0329_PROBE     1
+#endif
+#define GC0329_DEV_ID           (0x31)      //slave_address:0x62
+#define GC0329_CHIP_ID          (0xC0)
+
 #endif
 
